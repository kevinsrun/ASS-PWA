# Copy this file to .env.local, then replace placeholders with dashboard values.
# Keep .env.example placeholder-only because it is committed to GitHub.

# Supabase Dashboard -> Project Settings -> API Keys
# Safe for browser use. These are protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase secret. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional compatibility for projects still using the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEYS=your_gemini_key

# Google OAuth (Web application). Enable both Google Calendar API and Gmail API.
# Add the redirect URI below to Google Cloud -> OAuth client -> Authorized redirect URIs.
# In production, use https://YOUR_DOMAIN/api/auth/google/callback instead.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Canvas LMS (server-only personal integration)
CANVAS_BASE_URL=https://canvas.brown.edu
CANVAS_ACCESS_TOKEN=your_canvas_access_token

# Scheduled routes
CRON_SECRET=your_random_cron_secret
