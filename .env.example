# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase access. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Gemini
GEMINI_API_KEYS=your_gemini_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Canvas LMS (server-only personal integration)
CANVAS_BASE_URL=https://canvas.brown.edu
CANVAS_ACCESS_TOKEN=your_canvas_access_token

# Scheduled routes
CRON_SECRET=your_random_cron_secret
