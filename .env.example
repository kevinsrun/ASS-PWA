# Copy this file to .env.local, then replace placeholders with dashboard values.
# Keep .env.example placeholder-only because it is committed to GitHub.

# Supabase Dashboard -> Project Settings -> API Keys
# Safe for browser use. These are protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase secret. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional compatibility for projects still using the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEYS=your_gemini_key

# Google OAuth (Web application). Enable Google Calendar, Gmail, and Drive APIs.
# Add the redirect URI below to Google Cloud -> OAuth client -> Authorized redirect URIs.
# In production, use https://YOUR_DOMAIN/api/auth/google/callback instead.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional weather decision context (defaults to Providence/Brown coordinates).
# Use a real contact address in production per api.weather.gov policy.
ASS_WEATHER_LAT=41.8268
ASS_WEATHER_LON=-71.4025
ASS_WEATHER_USER_AGENT=ASS-PWA/1.0 (you@example.com)

# Canvas LMS (server-only personal integration)
CANVAS_BASE_URL=https://canvas.brown.edu
CANVAS_ACCESS_TOKEN=your_canvas_access_token

# Scheduled routes
CRON_SECRET=your_random_cron_secret

# Plaid (server-only). Start with sandbox, then request Development/Production access.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your_32_byte_random_secret
# Public HTTPS URL receiving Plaid transaction webhooks (optional locally).
PLAID_WEBHOOK_URL=https://YOUR_DOMAIN/api/plaid/webhook
# Required by OAuth institutions such as Chase; register the exact URI in Plaid.
PLAID_REDIRECT_URI=https://YOUR_DOMAIN/finance
